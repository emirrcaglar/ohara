DEPLOY_SERVER="user@your-vps"
# Required for SSH, SCP, and sudo on both Windows and Linux; no password prompts.
DEPLOY_PASSWORD=""

# code's dependent on these paths for now, better to keep them as is, or change them in the code as well
DEPLOY_DIR="/opt/ohara"
DEPLOY_DATA_DIR="/var/lib/ohara"
DEPLOY_CONFIG_DIR="/etc/ohara"
DEPLOY_BINARY_NAME="ohara"
DEPLOY_SERVICE_NAME="ohara"
